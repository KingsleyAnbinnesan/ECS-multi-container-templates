{
    "family":  "\u003cbi-web-task-definition-name\u003e",
    "containerDefinitions":  [
                                 {
                                     "name":  "\u003cbi-web-container-name\u003e",
                                     "image":  "us-docker.pkg.dev/boldbi-294612/boldbi/boldbi-server:\u003cupdate the latest image\u003e",
                                     "cpu":  512,
                                     "memory":  1024,
                                     "portMappings":  [
                                                          {
                                                              "containerPort":  80,
                                                              "hostPort":  80,
                                                              "protocol":  "tcp",
                                                              "name":  "bi-web",
                                                              "appProtocol":  "http"
                                                          }
                                                      ],
                                     "essential":  true,
                                     "environment":  [
                                                         {
                                                             "name":  "REPORTS_JOBS_SERVICE_URL",
                                                             "value":  "http://reports-jobs-service:6552/reporting/jobs"
                                                         },
                                                         {
                                                             "name":  "BI_DESIGNER_HELPER_SERVICE_URL",
                                                             "value":  "http://bi-dataservice-service:6007/bi/designer/helper"
                                                         },
                                                         {
                                                             "name":  "REPORTS_VIEWER_SERVICE_URL",
                                                             "value":  "http://reports-viewer-service:6554/reporting/viewer"
                                                         },
                                                         {
                                                             "name":  "BI_DESIGNER_SERVICE_URL",
                                                             "value":  "http://bi-dataservice-service:6007/bi/designer"
                                                         },
                                                         {
                                                             "name":  "BOLD_SERVICES_STORAGETYPE",
                                                             "value":  "3"
                                                         },
                                                         {
                                                             "name":  "BI_JOBS_SERVICE_URL",
                                                             "value":  "http://bi-jobs-service:6006/bi/jobs"
                                                         },
                                                         {
                                                             "name":  "BOLD_SERVICES_PV_USED",
                                                             "value":  "false"
                                                         },
                                                         {
                                                             "name":  "BI_WEB_SERVICE_URL",
                                                             "value":  "http://bi-web-service:6004/bi"
                                                         },
                                                         {
                                                             "name":  "BOLD_AI_SERVICE_URL",
                                                             "value":  "http://bold-ai-service:6010/aiservice"
                                                         },
                                                         {
                                                             "name":  "APP_BASE_URL",
                                                             "value":  "https://\u003capplication-domain\u003e"
                                                         },
                                                         {
                                                             "name":  "BOLD_SERVICES_HOSTING_ENVIRONMENT",
                                                             "value":  "docker"
                                                         },
                                                         {
                                                             "name":  "REPORTS_API_SERVICE_URL",
                                                             "value":  "http://reports-api-service:6551/reporting/api"
                                                         },
                                                         {
                                                             "name":  "BI_API_SERVICE_URL",
                                                             "value":  "http://bi-api-service:6005/bi/api"
                                                         },
                                                         {
                                                             "name":  "BOLD_SERVICES_AMAZON_BUCKET_NAME",
                                                             "value":  "\u003cprovide the s3 bucket name\u003e"
                                                         },
                                                         {
                                                             "name":  "ID_API_SERVICE_URL",
                                                             "value":  "http://id-api-service:6001/api"
                                                         },
                                                         {
                                                             "name":  "BOLD_ETL_SERVICE_URL",
                                                             "value":  "http://bold-etl-service:6009"
                                                         },
                                                         {
                                                             "name":  "BOLD_SERVICES_AMAZON_ROOTFOLDER_NAME",
                                                             "value":  "\u003cprovide the aws root folder name\u003e"
                                                         },
                                                         {
                                                             "name":  "ID_WEB_SERVICE_URL",
                                                             "value":  "http://id-web-service:6000"
                                                         },
                                                         {
                                                             "name":  "REPORTS_DESIGNER_SERVICE_URL",
                                                             "value":  "http://reports-reportservice-service:6553/reporting/reportservice"
                                                         },
                                                         {
                                                             "name":  "BOLD_ETL_BLAZOR_SERVICE_URL",
                                                             "value":  "http://bold-etl-service:6009/framework/blazor.server.js"
                                                         },
                                                         {
                                                             "name":  "REPORTS_WEB_SERVICE_URL",
                                                             "value":  "http://reports-web-service:6550/reporting"
                                                         },
                                                         {
                                                             "name":  "BOLD_SERVICES_AWS_REGION",
                                                             "value":  "\u003caws-region\u003e"
                                                         },
                                                         {
                                                             "name":  "ID_UMS_SERVICE_URL",
                                                             "value":  "http://id-ums-service:6002/ums"
                                                         }
                                                     ],
                                     "mountPoints":  [

                                                     ],
                                     "volumesFrom":  [

                                                     ],
                                     "secrets":  [
                                                     {
                                                         "name":  "BOLD_SERVICES_AWS_ACCESS_KEY_ID",
                                                         "valueFrom":  "arn:aws:secretsmanager:\u003cregion\u003e:\u003caccount-id\u003e:secret:\u003csecret-name\u003e:BOLD_SERVICES_AWS_ACCESS_KEY_ID::"
                                                     },
                                                     {
                                                         "name":  "BOLD_SERVICES_AWS_SECRET_ACCESS_KEY",
                                                         "valueFrom":  "arn:aws:secretsmanager:\u003cregion\u003e:\u003caccount-id\u003e:secret:\u003csecret-name\u003e:BOLD_SERVICES_AWS_SECRET_ACCESS_KEY::"
                                                     }
                                                 ],
                                     "logConfiguration":  {
                                                              "logDriver":  "awslogs",
                                                              "options":  {
                                                                              "awslogs-group":  "boldbi",
                                                                              "awslogs-region":  "\u003caws-region\u003e",
                                                                              "awslogs-stream-prefix":  "ecs"
                                                                          }
                                                          },
                                     "healthCheck":  {
                                                         "command":  [
                                                                         "CMD-SHELL",
                                                                         "curl -f http://localhost:80/health-check || exit 1"
                                                                     ],
                                                         "interval":  30,
                                                         "timeout":  10,
                                                         "retries":  3,
                                                         "startPeriod":  60
                                                     },
                                     "systemControls":  [

                                                        ]
                                 }
                             ],
    "taskRoleArn":  "\u003cecs-task-role-arn\u003e",
    "executionRoleArn":  "\u003cecs-task-execution-role-arn\u003e",
    "networkMode":  "awsvpc",
    "volumes":  [

                ],
    "placementConstraints":  [

                             ],
    "requiresCompatibilities":  [
                                    "FARGATE"
                                ],
    "cpu":  "2048",
    "memory":  "4096"
}
